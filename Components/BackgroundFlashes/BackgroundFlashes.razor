<div class="styleBackground @Class" style=@SpecialStyles id=@Id>
    @if(Flashes==true){
        <div class="first-flash"></div>
        <div class="second-flash"></div>
    }
    @ChildContent
</div>

@code
{
    [Parameter]
    public RenderFragment? ChildContent {get;set;}
    [Parameter]
    public string? SpecialStyles {get;set;}
    [Parameter]
    public string? Class {get;set;}
    [Parameter]
    public bool? Flashes {get;set;} = true;
    [Parameter]
    public string? Id {get; set;}
}
