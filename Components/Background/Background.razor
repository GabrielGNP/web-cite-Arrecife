<div class="styleBackground @Class" style="@Styles" id=@Id>
    @ChildContent
</div>

@code
{
    [Parameter]
    public RenderFragment? ChildContent {get;set;}

    [Parameter]
    public string? Styles {get; set;}

    [Parameter]
    public string? Class {get; set;}

    [Parameter]
    public string? Id {get; set;}
}
