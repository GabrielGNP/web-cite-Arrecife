<button class="blackButton" style="height: @(Height+"px"); width:@(Width+"px")" @onclick='@ExecuteActionButton'>
    @ChildContent
</button>

@code{
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Width {get; set;} = "50";
    
    [Parameter]
    public int? Height {get; set;} = 50;

    [Parameter]
    public EventCallback ActionButton {get; set;}

    async Task ExecuteActionButton(){
        await ActionButton.InvokeAsync();
    }

}