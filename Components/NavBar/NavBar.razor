@using Web_Cite_Arrecife.Components.ColoredButton;
@using Web_Cite_Arrecife.Components.SVGs
@inject NavigationManager Nav

<div class="navBar glass-effect">
    <div class="content-navBar">
        <div class="first-space-navBar">
            <div class="iconApp"></div>
            <p class="gradientText appName">Arrecife</p>
        </div>
        <div class="second-space-navBar">
            <a class="aNav" href="" @onclick='() => GoToSection("id_features")'>Características</a>
            <a class="aNav" href="" @onclick='() => GoToSection("id_security")'>Seguridad</a>
            <a class="aNav" href="" @onclick='() => GoToSection("id_working")'>Cómo Funciona</a>
            <TransparentButton>
                <SVG_Sun></SVG_Sun>
            </TransparentButton>
            <ColoredButton text="Descargar App"></ColoredButton>
        </div>
    </div>

</div>
@code {
    void GoToSection(string id){
        Nav.NavigateTo($"/#{id}", forceLoad:true);
    }
}
