@using Arrecife_Website.Components.ColoredButton;
@using Arrecife_Website.Components.MenuMovil
@using Arrecife_Website.Components.SVGs
@using Arrecife_Website.Services
@inject NavigationService NavService

<div class="navBar glass-effect">
    <div class="content-navBar">
        <a class="first-space-navBar" @onclick='() => NavService.GoToSection("id_principalContent")'>
            <div class="iconApp">
                <SVG_Arrecife Color="var(--whiteText)" Width="40" Height="40"/>
            </div>
            <span class="gradientText appName" >Arrecife</span>
        </a>
        <div class="second-space-navBar">
            <a class="aNav" href="" @onclick='() => NavService.GoToSection("id_features")'>Características</a>
            <a class="aNav" href="" @onclick='() => NavService.GoToSection("id_security")'>Seguridad</a>
            <a class="aNav" href="" @onclick='() => NavService.GoToSection("id_working")'>Cómo Funciona</a>
            @* <TransparentButton>
                <SVG_Sun></SVG_Sun>
            </TransparentButton> *@
            <ColoredButton Class="buttonBloqued" text="Descargar App"></ColoredButton>
        </div>
        <TransparentButton Class="minWidth900 " onclick="() => ChangeVisibilityMenu()">
                <SVGs_Menu Color="white" Height=30 Width=30></SVGs_Menu>
        </TransparentButton>
    </div>
</div>
<MenuMovil showMenu=@showMenu changeVisibilityMenu="@ChangeVisibilityMenu"></MenuMovil>


@code{
    public bool showMenu = false;

    void ChangeVisibilityMenu(){
        showMenu = !showMenu;
    }
}