<dialog open="@ShowModal" class="reactiveDialog" @onclick="@OnChangeShow">
    <div class="mainContent" @onclick:stopPropagation>
        @ChildContent
        
        <button class="closeButton" @onclick="@OnChangeShow">X</button>
    </div>
</dialog>

@code
{
    [Parameter]
    public RenderFragment? ChildContent {get;set;}

    [Parameter]
    public bool ShowModal {get; set;} = false;

    [Parameter]
    public EventCallback ChangeShowModal {get; set;}

    async Task OnChangeShow(){
        await ChangeShowModal.InvokeAsync();
    }
}