<button class="coloredButton hoverButton @Class" @onclick='@ExecuteActionButton'>
    @text
</button>


@code{
    [Parameter]
    public string? text { get; set; }

    [Parameter]
    public string? Class {get; set;}

    [Parameter]
    public EventCallback ActionButton {get; set;}

    async Task ExecuteActionButton(){
        await ActionButton.InvokeAsync();
    }
}