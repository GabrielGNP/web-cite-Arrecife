                </GradientRectangle>
                <p class="tc-white fs20 fw600 pd10">Descarga la App</p>
                <p>Instalación rápida y gratuita.</p>
            </div>
            <div class="flex-column center flex1 height100ps">
                <GradientRectangle Height=75 Width=75>
                    <SVG_Lock Color="var(--whiteText)" Width=40 Height=40/>
                    <Circle>02</Circle>
                </GradientRectangle>
                <p class="tc-white fs20 fw600 pd10">Crea tu Bóveda</p>
                <p>Escribe tu contraseña maestra para crear tu bóveda.</p>
            </div>
            <div class="flex-column center flex1 height100ps">
                <GradientRectangle Height=75 Width=75>
                    <SVG_Shield Color="var(--whiteText)" Width=40 Height=40></SVG_Shield>
                    <Circle>03</Circle>
                </GradientRectangle>
                <p class="tc-white fs20 fw600 pd10">Añade Credenciales</p>
                <p>Guarda de forma organizada la información sobre tus cuentas.</p>
            </div>
            <div class="flex-column center flex1 height100ps">
                <GradientRectangle Height=75 Width=75>
                    <SVG_Phone Color="var(--whiteText)" Width=40 Height=40/>
                    <Circle>04</Circle>
                </GradientRectangle>
                <p class="tc-white fs20 fw600 pd10">Accede Fácilmente</p>
                <p>Usa tus credenciales cuando las necesites con total seguridad.</p>
            </div>
        </div>
        <div class="cells4flex">
            <div class="flex-line gap4 jc-center">
                <div class="flex-column center flex1 height100ps">
                    <GradientRectangle Height=75 Width=75>
                        <SVG_Download Color="var(--whiteText)" Width=40 Height=40/>
                        <Circle>01</Circle>
                    </GradientRectangle>
                    <p class="tc-white fs20 fw600 pd10">Descarga la App</p>
                    <p>Instalación rápida y gratuita.</p>
                </div>
                <div class="flex-column center flex1 height100ps">
                    <GradientRectangle Height=75 Width=75>
                        <SVG_Lock Color="var(--whiteText)" Width=40 Height=40/>
                        <Circle>02</Circle>
                    </GradientRectangle>
                    <p class="tc-white fs20 fw600 pd10">Crea tu Bóveda</p>
                    <p>Escribe tu contraseña maestra para crear tu bóveda.</p>
                </div>
            </div>
            <div class="flex-line gap4 jc-center">
                <div class="flex-column center flex1 height100ps">
                    <GradientRectangle Height=75 Width=75>
                        <SVG_Shield Color="var(--whiteText)" Width=40 Height=40></SVG_Shield>
                        <Circle>03</Circle>
                    </GradientRectangle>
                    <p class="tc-white fs20 fw600 pd10">Añade Credenciales</p>
                    <p>Guarda de forma organizada la información sobre tus cuentas.</p>
                </div>
                <div class="flex-column center flex1 height100ps">
                    <GradientRectangle Height=75 Width=75>
                        <SVG_Phone Color="var(--whiteText)" Width=40 Height=40/>
                        <Circle>04</Circle>
                    </GradientRectangle>
                    <p class="tc-white fs20 fw600 pd10">Accede Fácilmente</p>
                    <p>Usa tus credenciales cuando las necesites con total seguridad.</p>
                </div>
            </div>
        </div>
    </div>
</Background>
<BackgroundLinearGradient SpecialStyles="padding: 50px; box-sizing: border-box; text-align: center;">
    <h2 class="fs50 pd10">Descarga <text class="gradientText">Arrecife</text> hoy</h2>
    <p class="fs20">Mantén segura y accesible tu información con nuestro arrecife digital</p>
    <div>
        <BlackButton Height=40 Width="130" ActionButton='() => ChangeModalContent("Download")'>
            <p class="tc-white flex-line center jc-spaceEvenly">
                <SVG_Apple Height=15 Width=15/> 
                App Store
            </p>
        </BlackButton>
        <BlackButton Height=40 Width="130" ActionButton='() => ChangeModalContent("Download")'>
            <p class="tc-white flex-line center jc-spaceEvenly">
                <SVG_Play Height=15 Width=15/>
                Play Store
            </p>
        </BlackButton>
    </div>
</BackgroundLinearGradient>
<Background Styles="min-height:200px; border-top: 1px solid color-mix(in oklch, var(--black) 100%, white)">
    <div class="footer">
        <div class="flex1">
            <div class="flex-line ai-center">
                <div class="iconApp">
                    <SVG_Arrecife Color="var(--whiteText)" Width="40" Height="40"/>
                </div>
                <p style="padding-left:5px" class="tc-white fw600 fs20"> Arrecife</p>
            </div>
            <p class="fs15 pd-block10">Tu regudio seguro para credenciales digitales.</p>
        </div>
        <div class="flex1 flex-column">
            <p class="tc-white fw600 pd-block10 fs20">Producto</p>
            <a class="anchorHover tc-grey fs15 pd-block10" @onclick='() => NavService.GoToSection("id_features")'>Características</a>
            <a class="anchorHover tc-grey fs15 pd-block10" @onclick='() => NavService.GoToSection("id_security")'>Seguridad</a>
            <a class="anchorHover tc-grey fs15 pd-block10" @onclick='() => ChangeModalContent("FAQ")'>FAQ</a>
        </div>
        <div class="flex1 flex-column">
            <p class="tc-white fw600 pd-block10 fs20">Compañia</p>
            <a class="anchorHover tc-grey fs15 pd-block10" @onclick='() => ChangeModalContent("AboutUs")'>Sobre Nosotros</a>
            <a class="anchorHover tc-grey fs15 pd-block10" @onclick='() => ChangeModalContent("contact")'>Contacto</a>
            <a class="anchorHover tc-grey fs15 pd-block10" @onclick='() => ChangeModalContent("contact")'>Soporte</a>
        </div>
        <div class="flex1 flex-column">
            <p class="tc-white fw600 pd-block10 fs20">Legal</p>
            <a class="anchorHover tc-grey fs15 pd-block10" @onclick='() => ChangeModalContent("Legal")'>Privacidad</a>
            <a class="anchorHover tc-grey fs15 pd-block10" @onclick='() => ChangeModalContent("Legal")'>Terminos</a>
            <a class="anchorHover tc-grey fs15 pd-block10" @onclick='() => ChangeModalContent("Legal")'>Seguridad</a>
        </div>
    </div>
    <div class="dividingLine"></div>
    <div class="flex-line contentSpacing totalWidth jc-spaceBetween pd-inline15">
        <p class="fs15">© 2026 Arrecife. Todos los derechos reservados.</p>
        <div>
            <a Class="anchorHover marg5" href="https://github.com/GabrielGNP" target="_blank" rel="noopener noreferrer">
                <SVG_Github Width=20 Height=20 Color="inherit"/>
            </a>
            <a Class="anchorHover marg5" href="https://www.linkedin.com/in/gabriel-perero/" target="_blank" rel="noopener noreferrer">
                <SVG_LinkedIn Width=20 Height=20 Color="inherit"/>
            </a>
            <a Class="anchorHover marg5" @onclick='() => ChangeModalContent("contact")'>
                <SVG_Mail Width=20 Height=20 Color="inherit"/>
            </a>            
        </div>
    </div>
</Background>
<ReactiveDialog showModal=@showReactiveDialog ChangeShowModal="ChangeShowModal">
    @contentModal
</ReactiveDialog>

@code{
    RenderFragment? contentModal;

    bool showReactiveDialog = false;

    void ChangeShowModal(){
        showReactiveDialog = !showReactiveDialog;
    }

    void ChangeModalContent(string opModal){
        switch (opModal)
        {
            case "contact":
                contentModal = builder =>
                {
                    builder.OpenElement(0, "div");
                    
                    builder.OpenElement(1, "p");
                    builder.AddContent(2, "Para contactar al desarrollador puede enviar un correo a:");
                    builder.CloseElement();

                    builder.OpenElement(3, "p");
                    builder.AddAttribute(4, "class", "tc-white pd-block10");
                    builder.AddContent(5, "GabrielPereroJob@gmail.com");
                    builder.CloseElement();

                    builder.CloseElement();
                };
                break;
            case "FAQ":
                contentModal = builder =>
                {
                    builder.OpenElement(0, "div");
                    
                    builder.OpenElement(1, "p");
                    builder.AddAttribute(2, "class", "workInProgress marg-bottom20");
                    builder.AddContent(3, "⚠️Work in Progress");
                    builder.CloseElement();

                    builder.OpenElement(4, "p");
                    builder.AddContent(5, "La aplicación está en sus últimas etapas de desarrollo por lo que aún no existen algunos apartados del sitio web aún no están completos.");
                    builder.CloseElement();

                    builder.OpenElement(6, "p");
                    builder.AddAttribute(7, "class", "tc-white pd-block10");
                    builder.AddContent(8, "Las FAQ serán agregadas próximamente.");
                    builder.CloseElement();

                    builder.CloseElement();
                };
                break;
            case "AboutUs":
                contentModal = builder =>
                {
                    builder.OpenElement(0, "div");
                    
                    builder.OpenElement(1, "p");
                    builder.AddAttribute(2, "class", "workInProgress marg-bottom20");
                    builder.AddContent(3, "⚠️Work in Progress");
                    builder.CloseElement();

                    builder.OpenElement(4, "p");
                    builder.AddContent(5, "La aplicación está en sus últimas etapas de desarrollo por lo que aún no existen algunos apartados del sitio web aún no están completos.");
                    builder.CloseElement();

                    builder.OpenElement(6, "p");
                    builder.AddAttribute(7, "class", "tc-white pd-block10");
                    builder.AddContent(8, "La sección \"Sobre nosotros\" será agregada próximamente.");
                    builder.CloseElement();

                    builder.CloseElement();
                };
                break;
            case "Legal":
                contentModal = builder =>
                {
                    builder.OpenElement(0, "div");
                    
                    builder.OpenElement(1, "p");
                    builder.AddAttribute(2, "class", "workInProgress marg-bottom20");
                    builder.AddContent(3, "⚠️Work in Progress");
                    builder.CloseElement();

                    builder.OpenElement(4, "p");
                    builder.AddContent(5, "La aplicación está en sus últimas etapas de desarrollo por lo que aún no existen algunos apartados del sitio web aún no están completos.");
                    builder.CloseElement();

                    builder.OpenElement(6, "p");
                    builder.AddAttribute(7, "class", "tc-white pd-block10");
                    builder.AddContent(8, "La sección \"Legal\" será agregada próximamente.");
                    builder.CloseElement();

                    builder.CloseElement();
                };
                break;
            case "Download":
                contentModal = builder =>
                {
                    builder.OpenElement(0, "div");
                    
                    builder.OpenElement(1, "p");
                    builder.AddAttribute(2, "class", "workInProgress marg-bottom20");
                    builder.AddContent(3, "⚠️Work in Progress");
                    builder.CloseElement();

                    builder.OpenElement(4, "p");
                    builder.AddContent(5, "La aplicación está en sus últimas etapas de desarrollo por lo que aún no es posible descargar la aplicación.");
                    builder.CloseElement();

                    builder.OpenElement(6, "p");
                    builder.AddAttribute(7, "class", "tc-white pd-block10");
                    builder.AddContent(8, "Próximamente se habilitarán las descargas y la previsualización.");
                    builder.CloseElement();

                    builder.CloseElement();
                };
                break;
            default:
                contentModal = builder => {
                    builder.OpenElement(0,"p");
                    builder.AddContent(1, "example");
                    builder.CloseElement();
                };
                break;
            
        }
        ChangeShowModal();
    }
}